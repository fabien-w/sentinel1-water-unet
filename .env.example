# Copy this file to .env (git-ignored) and fill in your values. Never commit .env.
# Needed only to download new scenes from the requester-pays bucket s3://sentinel-s1-l1c.
# Either an AWS profile from ~/.aws/credentials ...
AWS_PROFILE=default
# ... or access keys of an IAM user with s3:GetObject and s3:ListBucket:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
